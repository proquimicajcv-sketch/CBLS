    let vistaActual = "markdown";

    function obtenerReinoSeleccionado() {
      return document.querySelector('input[name="reino"]:checked').value;
    }

    function actualizarEtiquetasUI(reino) {
      const cfg = CONFIG_REINO[reino];
      document.getElementById("codigo_catalogo").value = cfg.prefijo;
      document.getElementById("lbl_grupo_taxonomico").textContent = cfg.lbl_grupo_taxonomico;
      document.getElementById("grupo_taxonomico").placeholder = cfg.ph_grupo_taxonomico;
      document.getElementById("lbl_actividad_fenologia").textContent = cfg.lbl_actividad_fenologia;
      document.getElementById("actividad_fenologia").placeholder = cfg.ph_actividad_fenologia;
      document.getElementById("lbl_alerta_prioritaria").textContent = cfg.lbl_alerta_prioritaria;
      document.getElementById("lbl_individuos").textContent = cfg.lbl_individuos;
      document.getElementById("individuos_observados").placeholder = cfg.ph_individuos;
      document.getElementById("lbl_etiqueta_foto").textContent = cfg.lbl_etiqueta_foto;
      document.getElementById("etiqueta_foto").placeholder = cfg.ph_etiqueta_foto;
      document.getElementById("lbl_url_extra").textContent = cfg.lbl_url_extra;
      document.getElementById("lbl_notas_especificas").textContent = cfg.lbl_notas_especificas;
      document.getElementById("notas_especificas").placeholder = cfg.ph_notas_especificas;
      document.getElementById("lbl_titulo_ecologia").textContent = cfg.lbl_titulo_ecologia;
      document.getElementById("lbl_eco_1").textContent = cfg.lbl_eco_1;
      document.getElementById("lbl_eco_2").textContent = cfg.lbl_eco_2;
      document.getElementById("lbl_eco_3").textContent = cfg.lbl_eco_3;
      document.getElementById("lbl_eco_4").textContent = cfg.lbl_eco_4;
      renderizarSalida();
    }

    function obtenerDatosFormulario() {
      const reino = obtenerReinoSeleccionado();
      return {
        reino,
        taxonomia: {
          nombre_cientifico: document.getElementById("nombre_cientifico").value || "Sin definir",
          nombre_comun: document.getElementById("nombre_comun").value || "Sin definir",
          grupo_taxonomico: document.getElementById("grupo_taxonomico").value || "Sin definir",
          codigo_catalogo: document.getElementById("codigo_catalogo").value,
          categoria_uicn: document.getElementById("categoria_uicn").value,
          estado_curaduria: document.getElementById("estado_curaduria").value,
          actividad_o_fenologia: document.getElementById("actividad_fenologia").value || "No registrado",
          alerta_prioritaria: document.getElementById("alerta_prioritaria").checked
        },
        multimedia: {
          individuos_observados: document.getElementById("individuos_observados").value || "1 ind.",
          url_foto_principal: document.getElementById("url_foto").value || "https://ejemplo.com/imagen.jpg",
          etiqueta_foto: document.getElementById("etiqueta_foto").value || "Vista general",
          url_recurso_adicional: document.getElementById("url_extra").value || "",
          notas_bioacustica_o_sustrato: document.getElementById("notas_especificas").value || "No aplica"
        },
        ubicacion: {
          latitud_wgs84: parseFloat(document.getElementById("latitud").value) || 0,
          longitud_wgs84: parseFloat(document.getElementById("longitud").value) || 0,
          elevacion_msnm: parseInt(document.getElementById("elevacion").value, 10) || 0,
          zona_vida_holdridge: document.getElementById("zona_holdridge").value,
          localidad_cbls: document.getElementById("localidad").value
        },
        ecologia: {
          morfologia_o_anatomia: document.getElementById("eco_1").value || "Pendiente de curaduría.",
          etologia_o_fisiologia: document.getElementById("eco_2").value || "Pendiente de curaduría.",
          reproduccion_o_polinizacion: document.getElementById("eco_3").value || "Pendiente de curaduría.",
          relaciones_ecologicas: document.getElementById("eco_4").value || "Pendiente de curaduría.",
          datos_cientificos_confirmados: document.getElementById("datos_cientificos").value || "Pendiente de curaduría."
        }
      };
    }

    function generarMarkdown(data) {
      const cfg = CONFIG_REINO[data.reino];
      const checkAlerta = data.taxonomia.alerta_prioritaria ? "[X]" : "[ ]";

      return `### **Taxonomía y datos básicos de curaduría**
* **Nombre científico (binomio):** *${data.taxonomia.nombre_cientifico}*
* **Nombre común / vernáculo:** ${data.taxonomia.nombre_comun}
* **${cfg.lbl_grupo_taxonomico}:** ${data.taxonomia.grupo_taxonomico}
* **Código de catálogo CBLS:** ${data.taxonomia.codigo_catalogo}
* **Categoría Lista Roja UICN:** ${data.taxonomia.categoria_uicn}
* **Estado de curaduría:** ${data.taxonomia.estado_curaduria}
* **${cfg.lbl_actividad_fenologia}:** ${data.taxonomia.actividad_o_fenologia}
* **${cfg.lbl_alerta_prioritaria}:** \`${checkAlerta}\`

---

### **Multimedia y registros**
* **${cfg.lbl_individuos}:** ${data.multimedia.individuos_observados}
* **URL de Fotografía Principal:** \`${data.multimedia.url_foto_principal}\`
* **${cfg.lbl_etiqueta_foto}:** ${data.multimedia.etiqueta_foto}
* **${cfg.lbl_url_extra}:** \`${data.multimedia.url_recurso_adicional || "No aplica"}\`

---

### **${cfg.lbl_notas_especificas}**
${data.multimedia.notas_bioacustica_o_sustrato}

---

### **Ubicación geográfica y Zona de vida Holdridge**
* **Latitud WGS84 (°N):** ${data.ubicacion.latitud_wgs84}
* **Longitud WGS84 (°W):** ${data.ubicacion.longitud_wgs84}
* **Elevación (m s.n.m.):** ${data.ubicacion.elevacion_msnm} m
* **Zona de vida Holdridge:** ${data.ubicacion.zona_vida_holdridge}
* **Localidad específica CBLS:** ${data.ubicacion.localidad_cbls}

---

### **${cfg.lbl_titulo_ecologia}**

* **${cfg.lbl_eco_1}:**  
  ${data.ecologia.morfologia_o_anatomia}

* **${cfg.lbl_eco_2}:**  
  ${data.ecologia.etologia_o_fisiologia}

* **${cfg.lbl_eco_3}:**  
  ${data.ecologia.reproduccion_o_polinizacion}

* **${cfg.lbl_eco_4}:**  
  ${data.ecologia.relaciones_ecologicas}

* **Datos científicos confirmados:**  
  ${data.ecologia.datos_cientificos_confirmados}`;
    }

    function renderizarSalida() {
      const data = obtenerDatosFormulario();
      const preview = document.getElementById("outputPreview");
      preview.textContent = vistaActual === "markdown"
        ? generarMarkdown(data)
        : JSON.stringify(data, null, 2);
    }

    // Eventos de cambio en el formulario
    document.querySelectorAll('input[name="reino"]').forEach(radio => {
      radio.addEventListener("change", (e) => actualizarEtiquetasUI(e.target.value));
    });

    document.getElementById("fichaForm").addEventListener("input", renderizarSalida);

    // Tabs Markdown / JSON
    document.getElementById("tabMarkdown").addEventListener("click", () => {
      vistaActual = "markdown";
      document.getElementById("tabMarkdown").className = "px-3 py-1 text-xs font-semibold rounded-md bg-emerald-600 text-slate-950";
      document.getElementById("tabJSON").className = "px-3 py-1 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700";
      renderizarSalida();
    });

    document.getElementById("tabJSON").addEventListener("click", () => {
      vistaActual = "json";
      document.getElementById("tabJSON").className = "px-3 py-1 text-xs font-semibold rounded-md bg-emerald-600 text-slate-950";
      document.getElementById("tabMarkdown").className = "px-3 py-1 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700";
      renderizarSalida();
    });

    // Botón Cargar Ejemplo según Reino activo
    document.getElementById("btnCargarEjemplo").addEventListener("click", () => {
      const reino = obtenerReinoSeleccionado();
      const ej = EJEMPLOS[reino];
      Object.keys(ej).forEach(key => {
        const el = document.getElementById(key);
        if (!el) return;
        if (el.type === "checkbox") el.checked = ej[key];
        else el.value = ej[key];
      });
      renderizarSalida();
    });

    // Botón Limpiar
    document.getElementById("btnLimpiar").addEventListener("click", () => {
      const reino = obtenerReinoSeleccionado();
      document.getElementById("fichaForm").reset();
      document.querySelector(`input[name="reino"][value="${reino}"]`).checked = true;
      actualizarEtiquetasUI(reino);
    });

    // Copiar al portapapeles
    document.getElementById("btnCopiar").addEventListener("click", async () => {
      const texto = document.getElementById("outputPreview").textContent;
      await navigator.clipboard.writeText(texto);
      const btn = document.getElementById("btnCopiar");
      btn.textContent = "¡Copiado!";
      setTimeout(() => (btn.textContent = "Copiar Código"), 1800);
    });

    // Exportar JSON
    document.getElementById("btnExportarJSON").addEventListener("click", () => {
      const data = obtenerDatosFormulario();
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${data.taxonomia.codigo_catalogo.toLowerCase()}_${data.taxonomia.nombre_cientifico.toLowerCase().replace(/\s+/g, "_")}.json`;
      a.click();
      URL.revokeObjectURL(url);
    });

    // Inicialización
    actualizarEtiquetasUI("Animalia");
  </script>
</body>
</html>