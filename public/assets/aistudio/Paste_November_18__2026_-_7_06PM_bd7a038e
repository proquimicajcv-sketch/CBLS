<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bitácora CBLS — Curaduría de Biodiversidad (Fauna y Flora)</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased">

  <!-- Header -->
  <header class="bg-emerald-950/80 border-b border-emerald-800/60 sticky top-0 z-20 backdrop-blur">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Corredor Biológico Los Santos · Costa Rica</span>
        <h1 class="text-xl sm:text-2xl font-bold text-white">Bitácora Científica CBLS (Fauna & Flora)</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="btnCargarEjemplo" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
          Cargar Ejemplo
        </button>
        <button id="btnLimpiar" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 transition">
          Limpiar Formulario
        </button>
        <button id="btnExportarJSON" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-slate-950 transition">
          Descargar JSON
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Columna Izquierda: Formulario Dinámico -->
    <section class="lg:col-span-7 space-y-6">
      <form id="fichaForm" class="space-y-6">

        <!-- Selector de Reino -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5">
          <label class="block text-xs font-semibold uppercase tracking-wider text-emerald-400 mb-3">
            1. Selección de Reino Biológico (Adapta el esquema automáticamente)
          </label>
          <div class="grid grid-cols-2 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="reino" value="Animalia" class="peer sr-only" checked />
              <div class="p-3 rounded-lg border border-slate-700 bg-slate-950 peer-checked:border-emerald-500 peer-checked:bg-emerald-950/40 text-center transition">
                <div class="font-bold text-sm">🐾 Fauna (Animalia)</div>
                <div class="text-xs text-slate-400">Prefijo CBLS-SP-XXX</div>
              </div>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="reino" value="Plantae" class="peer sr-only" />
              <div class="p-3 rounded-lg border border-slate-700 bg-slate-950 peer-checked:border-emerald-500 peer-checked:bg-emerald-950/40 text-center transition">
                <div class="font-bold text-sm">🌿 Flora (Plantae)</div>
                <div class="text-xs text-slate-400">Prefijo CBLS-FL-XXX</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Bloque 1: Taxonomía y Curaduría -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-emerald-400 border-b border-slate-800 pb-2">
            Taxonomía y Datos Básicos de Curaduría
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Nombre científico (binomio) *</label>
              <input type="text" id="nombre_cientifico" required placeholder="Ej. Quercus costaricensis"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm italic focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Nombre común / vernáculo *</label>
              <input type="text" id="nombre_comun" required placeholder="Ej. Roble de altura, encino"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label id="lbl_grupo_taxonomico" class="block text-xs text-slate-400 mb-1">Grupo taxonómico</label>
              <input type="text" id="grupo_taxonomico" placeholder="Ej. Aves (Passeriformes)"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Código de catálogo CBLS</label>
              <input type="text" id="codigo_catalogo" value="CBLS-SP-034"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Categoría Lista Roja UICN / Estatus</label>
              <select id="categoria_uicn" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none">
                <option value="LC — Preocupación menor">LC — Preocupación menor</option>
                <option value="NT — Casi amenazado">NT — Casi amenazado</option>
                <option value="VU — Vulnerable">VU — Vulnerable</option>
                <option value="EN — En peligro">EN — En peligro</option>
                <option value="CR — En peligro crítico">CR — En peligro crítico</option>
                <option value="NE — No evaluado / Endémico local">NE — No evaluado / Endémico local</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Estado de curaduría</label>
              <select id="estado_curaduria" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none">
                <option value="Borrador local">Borrador local</option>
                <option value="Validado en campo">Validado en campo</option>
                <option value="Publicado en Bitácora">Publicado en Bitácora</option>
              </select>
            </div>
            <div>
              <label id="lbl_actividad_fenologia" class="block text-xs text-slate-400 mb-1">Horario de actividad</label>
              <input type="text" id="actividad_fenologia" placeholder="Ej. Diurna / Nocturna"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div class="flex items-center pt-5">
              <label class="flex items-center gap-2 cursor-pointer text-sm">
                <input type="checkbox" id="alerta_prioritaria" class="w-4 h-4 accent-emerald-500 rounded" />
                <span id="lbl_alerta_prioritaria" class="text-slate-300">Alerta ofídica / veneno / prioritario</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Multimedia y Registros -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-emerald-400 border-b border-slate-800 pb-2">
            Multimedia y Registros Diagnósticos
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label id="lbl_individuos" class="block text-xs text-slate-400 mb-1">Individuos observados en hallazgo inicial</label>
              <input type="text" id="individuos_observados" placeholder="Ej. 1 ind. / Parche de 2 m²"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label id="lbl_etiqueta_foto" class="block text-xs text-slate-400 mb-1">Etiqueta anatómica de la foto</label>
              <input type="text" id="etiqueta_foto" placeholder="Ej. Vista dorsal / Detalle floral"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">URL de Fotografía Principal</label>
              <input type="url" id="url_foto" placeholder="https://..."
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label id="lbl_url_extra" class="block text-xs text-slate-400 mb-1">URL de Canto / Audio (opcional)</label>
              <input type="url" id="url_extra" placeholder="https://..."
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <div>
            <label id="lbl_notas_especificas" class="block text-xs text-slate-400 mb-1">Notas de bioacústica y contexto de emisión</label>
            <textarea id="notas_especificas" rows="2" placeholder="Describe vocalizaciones o sustrato/forófito..."
              class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>
        </div>

        <!-- Bloque 3: Ubicación Geográfica y Holdridge -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-emerald-400 border-b border-slate-800 pb-2">
            Ubicación Geográfica y Zona de Vida Holdridge
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Latitud WGS84 (°N)</label>
              <input type="number" step="0.0001" id="latitud" value="9.5850"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Longitud WGS84 (°W)</label>
              <input type="number" step="0.0001" id="longitud" value="-83.8250"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Elevación (m s.n.m.)</label>
              <input type="number" id="elevacion" value="2300"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Zona de vida Holdridge</label>
              <select id="zona_holdridge" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none">
                <option value="Bosque Pluvial Montano Bajo">Bosque Pluvial Montano Bajo</option>
                <option value="Bosque Pluvial Montano">Bosque Pluvial Montano</option>
                <option value="Páramo Pluvial Subalpino">Páramo Pluvial Subalpino</option>
                <option value="Bosque Muy Húmedo Premontano">Bosque Muy Húmedo Premontano</option>
              </select>
            </div>
            <div>
              <label class="block text-xs text-slate-400 mb-1">Localidad específica CBLS</label>
              <input type="text" id="localidad" value="Sector Copey / Cordillera de Talamanca, CBLS"
                class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Bloque 4: Campos de Investigación Biológica -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 space-y-4">
          <h2 id="lbl_titulo_ecologia" class="text-sm font-bold uppercase tracking-wider text-emerald-400 border-b border-slate-800 pb-2">
            Campos de Investigación Biológica y Ecología
          </h2>

          <div>
            <label id="lbl_eco_1" class="block text-xs font-semibold text-slate-300 mb-1">Cromática y anatomía del espécimen</label>
            <textarea id="eco_1" rows="3" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>

          <div>
            <label id="lbl_eco_2" class="block text-xs font-semibold text-slate-300 mb-1">Etología y comportamiento en sitio</label>
            <textarea id="eco_2" rows="3" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>

          <div>
            <label id="lbl_eco_3" class="block text-xs font-semibold text-slate-300 mb-1">Cortejo, reproducción y cuidado parental</label>
            <textarea id="eco_3" rows="3" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>

          <div>
            <label id="lbl_eco_4" class="block text-xs font-semibold text-slate-300 mb-1">Relaciones intra e interespecíficas</label>
            <textarea id="eco_4" rows="3" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Datos científicos confirmados</label>
            <textarea id="datos_cientificos" rows="3" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
          </div>
        </div>

      </form>
    </section>

    <!-- Columna Derecha: Vista Previa en Tiempo Real (Markdown / JSON) -->
    <aside class="lg:col-span-5 space-y-4">
      <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 sticky top-24">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <div class="flex gap-2">
            <button id="tabMarkdown" class="px-3 py-1 text-xs font-semibold rounded-md bg-emerald-600 text-slate-950">
              Ficha Markdown
            </button>
            <button id="tabJSON" class="px-3 py-1 text-xs font-semibold rounded-md bg-slate-800 text-slate-300 hover:bg-slate-700">
              Objeto JSON (App)
            </button>
          </div>
          <button id="btnCopiar" class="px-3 py-1 text-xs font-medium rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-700 text-emerald-400">
            Copiar Código
          </button>
        </div>

        <pre id="outputPreview" class="bg-slate-950 border border-slate-800 rounded-lg p-4 text-xs text-slate-300 overflow-x-auto whitespace-pre-wrap max-h-[72vh] overflow-y-auto font-mono leading-relaxed"></pre>
      </div>
    </aside>

  </main>

